# HUMID1 Telemetry Dashboard - Environment Variables

# -----------------------------------------------------------------------------
# Required Core Endpoints
# -----------------------------------------------------------------------------

# The public domain of your ThingsBoard CE IoT Core (e.g. https://app.humid1.com)
VITE_THINGSBOARD_URL=https://app.humid1.com

# The public domain of your Authentik SSO Identity Provider (e.g. https://auth.humid1.com)
VITE_AUTHENTIK_URL=https://auth.humid1.com

# -----------------------------------------------------------------------------
# OIDC & SSO Provider Settings
# -----------------------------------------------------------------------------

# The slug of the Authentik application provider (defaults to "humid1-dash")
VITE_AUTHENTIK_APP_SLUG=humid1-dash

# The OIDC Client ID of the Authentik OAuth2 provider flow
VITE_AUTHENTIK_CLIENT_ID=7nvidWHfM8C3wE3VKGqFNGFNnl9aou46mL5kporI

# -----------------------------------------------------------------------------
# Optional Customizations & Defaults
# -----------------------------------------------------------------------------

# The base public domain of this dashboard (defaults dynamically to window.location.origin)
VITE_DASHBOARD_URL=https://dash.humid1.com

# Custom OIDC callback redirect URI (defaults dynamically to active browser path)
VITE_APP_REDIRECT_URI=https://dash.humid1.com/auth/callback

# Default device name displayed when no claimed units are loaded
VITE_DEFAULT_DEVICE_NAME=CEDAR-CABINET-X9

# Branding & SEO variables
VITE_APP_TITLE=HUMID1 Telemetry Dashboard
VITE_APP_DESCRIPTION=Precision Humidor Monitoring & Telemetry.