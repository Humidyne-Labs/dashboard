{
  "packageId": "com.humid1.app",
  "host": "dash.humid1.com",
  "name": "HUMID1 Telemetry Dashboard",
  "launcherName": "HUMID1",
  "display": "standalone",
  "themeColor": "#0f172a",
  "themeColorDark": "#0b1120",
  "navigationColor": "#0f172a",
  "navigationColorDark": "#0b1120",
  "navigationDividerColor": "#1e293b",
  "navigationDividerColorDark": "#1e293b",
  "backgroundColor": "#0f172a",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://raw.githubusercontent.com/Humidyne-Labs/dashboard/main/public/pwa-512x512.png",
  "maskableIconUrl": "https://raw.githubusercontent.com/Humidyne-Labs/dashboard/main/public/pwa-maskable-512x512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android-keystore.jks",
    "alias": "humid1-key"
  },
  "appVersionName": "1.2.0",
  "appVersionCode": 120,
  "shortcuts": [
    {
      "name": "Live Telemetry",
      "shortName": "Telemetry",
      "url": "https://dash.humid1.com/#telemetry",
      "chosenIconUrl": "https://raw.githubusercontent.com/Humidyne-Labs/dashboard/main/public/pwa-192x192.png"
    },
    {
      "name": "Alarms & Alerts",
      "shortName": "Alarms",
      "url": "https://dash.humid1.com/#alarms",
      "chosenIconUrl": "https://raw.githubusercontent.com/Humidyne-Labs/dashboard/main/public/pwa-192x192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://raw.githubusercontent.com/Humidyne-Labs/dashboard/main/public/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": false
    },
    "playBilling": {
      "enabled": false
    }
  },
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true
}
